# Copiá este archivo como ".env" y completá los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Clave secreta de Django. Generá una con:
#   venv\Scripts\python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=poner-una-clave-secreta

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos PostgreSQL
DB_NAME=policampo
DB_USER=policampo
DB_PASSWORD=poner-la-contrasena
DB_HOST=localhost
DB_PORT=5432
